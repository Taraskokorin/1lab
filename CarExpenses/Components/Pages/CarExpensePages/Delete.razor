@page "/carexpenses/delete"
@using Microsoft.EntityFrameworkCore
@using CarExpenses.Models
@inject IDbContextFactory<CarExpenses.Data.CarExpensesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>CarExpense</h2>
    <hr />
    @if (carexpense is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Title</dt>
            <dd class="col-sm-10">@carexpense.Title</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Kind</dt>
            <dd class="col-sm-10">@carexpense.Kind</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Amount</dt>
            <dd class="col-sm-10">@carexpense.Amount</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">SpentOn</dt>
            <dd class="col-sm-10">@carexpense.SpentOn</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Odometer</dt>
            <dd class="col-sm-10">@carexpense.Odometer</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Liters</dt>
            <dd class="col-sm-10">@carexpense.Liters</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">NextServiceOn</dt>
            <dd class="col-sm-10">@carexpense.NextServiceOn</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Comment</dt>
            <dd class="col-sm-10">@carexpense.Comment</dd>
        </dl>
        <EditForm method="post" Model="carexpense" OnValidSubmit="DeleteCarExpense" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(carexpense is null)">Delete</button> |
            <a href="/carexpenses">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private CarExpense? carexpense;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        carexpense = await context.CarExpenses.FirstOrDefaultAsync(m => m.Id == Id);

        if (carexpense is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteCarExpense()
    {
        using var context = DbFactory.CreateDbContext();
        context.CarExpenses.Remove(carexpense!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/carexpenses");
    }
}
