@page "/carexpenses/delete"
@using Microsoft.EntityFrameworkCore
@using CarExpenses.Models
@inject IDbContextFactory<CarExpenses.Data.CarExpensesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Видалення витрати – Облік автомобіля</PageTitle>

@if (carexpense is not null)
{
    <h1>Видалити «@carexpense.Title»?</h1>
}

<p>Запис зникне назавжди. Перевірте, що видаляєте саме його.</p>
<div>
    @if (carexpense is null)
    {
        <p><em>Завантаження…</em></p>
    }
    else {
        <ExpenseCard Expense="carexpense" Caption="Перевірте, що видаляєте" ShowDetails="false" />
        <EditForm method="post" Model="carexpense" OnValidSubmit="DeleteCarExpense" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(carexpense is null)">Видалити</button> |
            <a href="/carexpenses">До переліку</a>
        </EditForm>
    }
</div>

@code {
    private CarExpense? carexpense;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        carexpense = await context.CarExpenses
            .Include(x => x.Vehicle).Include(x => x.Place)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (carexpense is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteCarExpense()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.CarExpenses.Remove(carexpense!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/carexpenses");
    }
}
