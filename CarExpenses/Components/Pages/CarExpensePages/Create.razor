@page "/carexpenses/create"
@using Microsoft.EntityFrameworkCore
@using CarExpenses.Models
@using Microsoft.Data.Sqlite
@inject IDbContextFactory<CarExpenses.Data.CarExpensesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Нова витрата – Облік автомобіля</PageTitle>

<h1>Нова витрата</h1>

<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="CarExpense" OnValidSubmit="AddCarExpense" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            @if (error is not null)
            {
                <div class="alert alert-danger">@error</div>
            }
            <div class="mb-3">
                <label for="title" class="form-label">Що оплачено:</label> 
                <InputText id="title" @bind-Value="CarExpense.Title" class="form-control" /> 
                <ValidationMessage For="() => CarExpense.Title" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="kind" class="form-label">Вид витрати:</label> 
                <InputSelect id="kind" @bind-Value="CarExpense.Kind" class="form-select">
                    @foreach (var kind in Enum.GetValues<ExpenseKind>())
                    {
                        <option value="@kind">@kind.ToUkrainian()</option>
                    }
                </InputSelect> 
                <ValidationMessage For="() => CarExpense.Kind" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="vehicle" class="form-label">Автомобіль:</label>
                <InputSelect id="vehicle" @bind-Value="CarExpense.VehicleId" class="form-select">
                    @foreach (var v in vehicles)
                    {
                        <option value="@v.Id">@v.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="mb-3">
                <label for="place" class="form-label">Місце:</label>
                <InputSelect id="place" @bind-Value="CarExpense.PlaceId" class="form-select">
                    @foreach (var p in places)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="mb-3">
                <label for="amount" class="form-label">Сума, грн:</label> 
                <InputNumber id="amount" @bind-Value="CarExpense.Amount" class="form-control" /> 
                <ValidationMessage For="() => CarExpense.Amount" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="spenton" class="form-label">Дата:</label> 
                <InputDate id="spenton" @bind-Value="CarExpense.SpentOn" class="form-control" /> 
                <ValidationMessage For="() => CarExpense.SpentOn" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="odometer" class="form-label">Пробіг, км:</label> 
                <InputNumber id="odometer" @bind-Value="CarExpense.Odometer" class="form-control" /> 
                <ValidationMessage For="() => CarExpense.Odometer" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="liters" class="form-label">Залито, л (лише для заправки):</label> 
                <InputNumber id="liters" @bind-Value="CarExpense.Liters" class="form-control" /> 
                <ValidationMessage For="() => CarExpense.Liters" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="nextserviceon" class="form-label">Наступне ТО (якщо відомо):</label> 
                <InputDate id="nextserviceon" @bind-Value="CarExpense.NextServiceOn" class="form-control" /> 
                <ValidationMessage For="() => CarExpense.NextServiceOn" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="comment" class="form-label">Коментар:</label> 
                <InputText id="comment" @bind-Value="CarExpense.Comment" class="form-control" /> 
                <ValidationMessage For="() => CarExpense.Comment" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Зберегти</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/carexpenses">До переліку</a>
</div>

@code {
    [SupplyParameterFromForm]
    private CarExpense CarExpense { get; set; } = default!;

    private string? error;

    private List<Vehicle> vehicles = new();
    private List<Place> places = new();

    protected override async Task OnInitializedAsync()
    {
        CarExpense ??= new() { SpentOn = DateOnly.FromDateTime(DateTime.Today) };

        await using var db = await DbFactory.CreateDbContextAsync();
        vehicles = await db.Vehicles.OrderBy(v => v.Name).ToListAsync();
        places = await db.Places.OrderBy(p => p.Name).ToListAsync();
    }

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddCarExpense()
    {
        if (CarExpense!.NextServiceOn is DateOnly next && next <= CarExpense.SpentOn)
        {
            error = "Дата наступного ТО має бути пізніша за дату витрати";
            return;
        }

        if (CarExpense.Liters is not null && CarExpense.Kind != ExpenseKind.Fuel)
        {
            error = "Літри зазначають лише для заправки: оберіть вид «Пальне» або очистіть поле";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        CarExpense.TitleSearch = CarExpense.Title.ToLowerInvariant();
        context.CarExpenses.Add(CarExpense);

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateException ex)
            when (ex.InnerException is SqliteException { SqliteExtendedErrorCode: 2067 })
        {
            error = "Такий запис уже є: для цього автомобіля того самого дня з тим самим пробігом і видом витрати";
            return;
        }
        NavigationManager.NavigateTo("/carexpenses?saved=true");
    }
}
