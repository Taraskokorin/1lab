@page "/carexpenses/edit"
@using Microsoft.EntityFrameworkCore
@using CarExpenses.Models
@using Microsoft.Data.Sqlite
@inject IDbContextFactory<CarExpenses.Data.CarExpensesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>CarExpense</h2>
<hr />
@if (CarExpense is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="CarExpense" OnValidSubmit="UpdateCarExpense" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert"/>
                @if (error is not null)
                {
                    <div class="alert alert-danger">@error</div>
                }
                <input type="hidden" name="CarExpense.Id" value="@CarExpense.Id" />
                <div class="mb-3">
                    <label for="title" class="form-label">Title:</label>
                    <InputText id="title" @bind-Value="CarExpense.Title" class="form-control" />
                    <ValidationMessage For="() => CarExpense.Title" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="kind" class="form-label">Kind:</label>
                    <InputSelect id="kind" @bind-Value="CarExpense.Kind" class="form-select">
                    @foreach (var kind in Enum.GetValues<ExpenseKind>())
                    {
                        <option value="@kind">@kind</option>
                    }
                </InputSelect>
                    <ValidationMessage For="() => CarExpense.Kind" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="vehicle" class="form-label">Автомобіль:</label>
                    <InputSelect id="vehicle" @bind-Value="CarExpense.VehicleId" class="form-select">
                        @foreach (var v in vehicles)
                        {
                            <option value="@v.Id">@v.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label for="place" class="form-label">Місце:</label>
                    <InputSelect id="place" @bind-Value="CarExpense.PlaceId" class="form-select">
                        @foreach (var p in places)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label for="amount" class="form-label">Amount:</label>
                    <InputNumber id="amount" @bind-Value="CarExpense.Amount" class="form-control" />
                    <ValidationMessage For="() => CarExpense.Amount" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="spenton" class="form-label">SpentOn:</label>
                    <InputDate id="spenton" @bind-Value="CarExpense.SpentOn" class="form-control" />
                    <ValidationMessage For="() => CarExpense.SpentOn" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="odometer" class="form-label">Odometer:</label>
                    <InputNumber id="odometer" @bind-Value="CarExpense.Odometer" class="form-control" />
                    <ValidationMessage For="() => CarExpense.Odometer" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="liters" class="form-label">Liters:</label>
                    <InputNumber id="liters" @bind-Value="CarExpense.Liters" class="form-control" />
                    <ValidationMessage For="() => CarExpense.Liters" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="nextserviceon" class="form-label">NextServiceOn:</label>
                    <InputDate id="nextserviceon" @bind-Value="CarExpense.NextServiceOn" class="form-control" />
                    <ValidationMessage For="() => CarExpense.NextServiceOn" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="comment" class="form-label">Comment:</label>
                    <InputText id="comment" @bind-Value="CarExpense.Comment" class="form-control" />
                    <ValidationMessage For="() => CarExpense.Comment" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/carexpenses">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private CarExpense? CarExpense { get; set; }

    private string? error;

    private List<Vehicle> vehicles = new();
    private List<Place> places = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        CarExpense ??= await context.CarExpenses
            .Include(x => x.Vehicle).Include(x => x.Place)
            .FirstOrDefaultAsync(m => m.Id == Id);

        vehicles = await context.Vehicles.OrderBy(v => v.Name).ToListAsync();
        places = await context.Places.OrderBy(p => p.Name).ToListAsync();

        if (CarExpense is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateCarExpense()
    {
        if (CarExpense!.NextServiceOn is DateOnly next && next <= CarExpense.SpentOn)
        {
            error = "Дата наступного ТО має бути пізніша за дату витрати";
            return;
        }

        if (CarExpense.Liters is not null && CarExpense.Kind != ExpenseKind.Fuel)
        {
            error = "Літри зазначають лише для заправки: оберіть вид «Fuel» або очистіть поле";
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        CarExpense.TitleSearch = CarExpense.Title.ToLowerInvariant();
        context.Attach(CarExpense!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateException ex)
            when (ex.InnerException is SqliteException { SqliteExtendedErrorCode: 2067 })
        {
            error = "Такий запис уже є: для цього автомобіля того самого дня з тим самим пробігом і видом витрати";
            return;
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!await CarExpenseExistsAsync(CarExpense!.Id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/carexpenses");
    }

    private async Task<bool> CarExpenseExistsAsync(int id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        return await context.CarExpenses.AnyAsync(e => e.Id == id);
    }
}
