@page "/carexpenses"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using CarExpenses.Models
@using CarExpenses.Data
@inject IDbContextFactory<CarExpenses.Data.CarExpensesContext> DbFactory

<PageTitle>Витрати – Облік автомобіля</PageTitle>

<h1>Витрати на автомобіль</h1>

@if (Saved)
{
    <div class="alert alert-success">Запис збережено</div>
}

<p>
    <a class="btn btn-primary" href="carexpenses/create">Додати витрату</a>
    <a class="btn btn-outline-secondary ms-2" href="@ExportUrl">Завантажити CSV</a>
</p>

<form method="get" class="row g-2 mb-3 row-cols-1 row-cols-md-auto">
  <div class="col">
    <input name="search" value="@Search" class="form-control"
           placeholder="Пошук за описом" />
  </div>
  <div class="col">
    <select name="vehicleId" class="form-select">
      <option value="">Усі автомобілі</option>
      @foreach (var v in vehicles)
      {
          <option value="@v.Id" selected="@(VehicleId == v.Id)">@v.Name</option>
      }
    </select>
  </div>
  <div class="col">
    <select name="sort" class="form-select">
      <option value="">За датою (нові спершу)</option>
      <option value="amount" selected="@(Sort == "amount")">За сумою</option>
      <option value="title" selected="@(Sort == "title")">За описом</option>
    </select>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-primary">Шукати</button>
  </div>
</form>

@if (!expenses.Any())
{
    <div class="alert alert-info">
        @if (Filtered)
        {
            <span>За цими умовами витрат не знайдено. <a href="carexpenses">Скинути пошук</a>.</span>
        }
        else
        {
            <span>Витрат ще немає. <a href="carexpenses/create">Додайте першу витрату</a> – наприклад, останню заправку.</span>
        }
    </div>
}
else
{
<div class="table-responsive">
<QuickGrid Class="table" Items="@expenses.Skip((CurrentPage - 1) * PageSize).Take(PageSize).AsQueryable()">
    <PropertyColumn Property="carexpense => carexpense.SpentOn" Title="Дата" Format="dd.MM.yyyy" />
    @* Назва веде на подробиці – окреме посилання «Подробиці» не потрібне. *@
    <TemplateColumn Title="Що оплачено" Context="carexpense">
        <a href="@($"carexpenses/details?id={carexpense.Id}")">@carexpense.Title</a>
    </TemplateColumn>
    <TemplateColumn Title="Вид" Class="d-none d-md-table-cell" Context="carexpense">@carexpense.Kind.ToUkrainian()</TemplateColumn>
    <PropertyColumn Property="carexpense => carexpense.Amount" Title="Сума, грн" Format="N2" Class="text-nowrap" />
    <PropertyColumn Property="carexpense => carexpense.Odometer" Title="Пробіг, км" Class="d-none d-md-table-cell" />
    <PropertyColumn Property="carexpense => carexpense.Liters" Title="Літри" Class="d-none d-xxl-table-cell" />
    <PropertyColumn Property="carexpense => carexpense.Vehicle!.Name" Title="Автомобіль" Class="d-none d-md-table-cell" />
    <PropertyColumn Property="carexpense => carexpense.Place!.Name" Title="Місце" Class="d-none d-xl-table-cell" />

    <TemplateColumn Class="text-nowrap" Context="carexpense">
        <a href="@($"carexpenses/edit?id={carexpense.Id}")">Змінити</a> |
        <a href="@($"carexpenses/delete?id={carexpense.Id}")">Видалити</a>
    </TemplateColumn>
</QuickGrid>
</div>
<nav>
@if (CurrentPage > 1) { <a class="btn btn-outline-secondary" href="@PageUrl(CurrentPage - 1)">Назад</a> }
<span class="mx-2">Сторінка @CurrentPage</span>
@if (expenses.Count > CurrentPage * PageSize) { <a class="btn btn-outline-secondary" href="@PageUrl(CurrentPage + 1)">Далі</a> }
</nav>
}

@code {
    private const int PageSize = 10;
    [SupplyParameterFromQuery] public int? Page { get; set; }
    private int CurrentPage => Page is > 0 ? Page.Value : 1;

    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public int? VehicleId { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "saved")]
    public bool Saved { get; set; }

    private bool Filtered => !string.IsNullOrWhiteSpace(Search) || VehicleId is not null;

    private List<CarExpense> expenses = new();
    private List<Vehicle> vehicles = new();

    protected override async Task OnInitializedAsync()
    {
        expenses = await LoadAsync();

        await using var db = await DbFactory.CreateDbContextAsync();
        vehicles = await db.Vehicles.OrderBy(v => v.Name).ToListAsync();
    }

    // Запит будують і виконують в одному методі: IQueryable не можна
    // віддавати назовні, бо контекст після виходу з методу звільнено.
    private async Task<List<CarExpense>> LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var q = db.CarExpenses.Include(x => x.Vehicle).Include(x => x.Place).AsQueryable();

        if (!string.IsNullOrWhiteSpace(Search))
        {
            var s = Search.Trim().ToLowerInvariant();
            q = q.Where(x => x.TitleSearch.Contains(s));
        }

        if (VehicleId is int id)
            q = q.Where(x => x.VehicleId == id);

        q = Sort switch
        {
            "amount" => q.OrderByDescending(x => x.Amount),
            "title"  => q.OrderBy(x => x.Title),
            _        => q.OrderByDescending(x => x.SpentOn).ThenByDescending(x => x.Odometer)
        };

        return await q.ToListAsync();
    }

    // Експорт бере ті самі умови відбору, що й перелік на екрані.
    private string ExportUrl =>
        $"export/carexpenses.csv?search={Uri.EscapeDataString(Search ?? "")}&vehicleId={VehicleId}";

    private string PageUrl(int page) =>
        $"carexpenses?page={page}&search={Uri.EscapeDataString(Search ?? "")}&vehicleId={VehicleId}&sort={Sort}";
}
