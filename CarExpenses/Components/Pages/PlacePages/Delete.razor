@page "/places/delete"
@using Microsoft.EntityFrameworkCore
@using CarExpenses.Models
@using Microsoft.Data.Sqlite
@inject IDbContextFactory<CarExpenses.Data.CarExpensesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Place</h2>
    <hr />
    @if (place is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@place.Name</dd>
        </dl>
        @if (error is not null)
        {
            <div class="alert alert-danger">@error</div>
        }
        <EditForm method="post" Model="place" OnValidSubmit="DeletePlace" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(place is null)">Delete</button> |
            <a href="/places">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Place? place;

    private string? error;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        place = await context.Places.FirstOrDefaultAsync(m => m.Id == Id);

        if (place is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeletePlace()
    {
        using var context = DbFactory.CreateDbContext();
        context.Places.Remove(place!);

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateException ex)
            when (ex.InnerException is SqliteException { SqliteErrorCode: 19 })
        {
            // 19 – SQLITE_CONSTRAINT; під час видалення так спрацьовує лише зовнішній ключ:
            // на запис посилаються витрати (DeleteBehavior.Restrict).
            error = "Цей місце використано у витратах, тому видалити його не можна. Спершу змініть або видаліть ці витрати.";
            return;
        }

        NavigationManager.NavigateTo("/places");
    }
}
