@page "/places/create"
@using Microsoft.EntityFrameworkCore
@using CarExpenses.Models
@inject IDbContextFactory<CarExpenses.Data.CarExpensesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Новий запис: місце – Облік автомобіля</PageTitle>

<h1>Новий запис: місце</h1>

<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Place" OnValidSubmit="AddPlace" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="name" class="form-label">Назва:</label> 
                <InputText id="name" @bind-Value="Place.Name" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Place.Name" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Зберегти</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/places">До переліку</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Place Place { get; set; } = default!;

    protected override void OnInitialized() => Place ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddPlace()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Places.Add(Place);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/places");
    }
}
