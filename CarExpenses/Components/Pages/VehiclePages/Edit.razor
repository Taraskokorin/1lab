@page "/vehicles/edit"
@using Microsoft.EntityFrameworkCore
@using CarExpenses.Models
@inject IDbContextFactory<CarExpenses.Data.CarExpensesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Vehicle</h2>
<hr />
@if (Vehicle is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Vehicle" OnValidSubmit="UpdateVehicle" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Vehicle.Id" value="@Vehicle.Id" />
                <div class="mb-3">
                <span class="text-danger">*</span>
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Vehicle.Name" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Vehicle.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="platenumber" class="form-label">PlateNumber:</label>
                    <InputText id="platenumber" @bind-Value="Vehicle.PlateNumber" class="form-control" />
                    <ValidationMessage For="() => Vehicle.PlateNumber" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/vehicles">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Vehicle? Vehicle { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        Vehicle ??= await context.Vehicles.FirstOrDefaultAsync(m => m.Id == Id);

        if (Vehicle is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateVehicle()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Attach(Vehicle!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!await VehicleExistsAsync(Vehicle!.Id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/vehicles");
    }

    private async Task<bool> VehicleExistsAsync(int id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        return await context.Vehicles.AnyAsync(e => e.Id == id);
    }
}
