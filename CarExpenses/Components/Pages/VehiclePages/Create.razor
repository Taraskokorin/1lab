@page "/vehicles/create"
@using Microsoft.EntityFrameworkCore
@using CarExpenses.Models
@inject IDbContextFactory<CarExpenses.Data.CarExpensesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Новий запис: автомобіль – Облік автомобіля</PageTitle>

<h1>Новий запис: автомобіль</h1>

<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Vehicle" OnValidSubmit="AddVehicle" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="name" class="form-label">Назва:</label> 
                <InputText id="name" @bind-Value="Vehicle.Name" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Vehicle.Name" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="platenumber" class="form-label">Номерний знак:</label> 
                <InputText id="platenumber" @bind-Value="Vehicle.PlateNumber" class="form-control" /> 
                <ValidationMessage For="() => Vehicle.PlateNumber" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Зберегти</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/vehicles">До переліку</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Vehicle Vehicle { get; set; } = default!;

    protected override void OnInitialized() => Vehicle ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddVehicle()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        context.Vehicles.Add(Vehicle);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/vehicles");
    }
}
