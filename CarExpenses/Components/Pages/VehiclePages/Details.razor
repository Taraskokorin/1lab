@page "/vehicles/details"
@using Microsoft.EntityFrameworkCore
@using CarExpenses.Models
@inject IDbContextFactory<CarExpenses.Data.CarExpensesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Подробиці: автомобіль – Облік автомобіля</PageTitle>

<h1>Подробиці: автомобіль</h1>

<div>
    @if (vehicle is null)
    {
        <p><em>Завантаження…</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Назва</dt>
            <dd class="col-sm-10">@vehicle.Name</dd>
            <dt class="col-sm-2">Номерний знак</dt>
            <dd class="col-sm-10">@vehicle.PlateNumber</dd>
        </dl>
        <div>
            <a href="@($"/vehicles/edit?id={vehicle.Id}")">Змінити</a> |
            <a href="@($"/vehicles")">До переліку</a>
        </div>
    }
</div>

@code {
    private Vehicle? vehicle;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        vehicle = await context.Vehicles.FirstOrDefaultAsync(m => m.Id == Id);

        if (vehicle is null)
        {
            NavigationManager.NotFound();
        }
    }
}
